<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@ViewData["Title"] - WebTimViec</title>
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
<header class="site-header">
<div class="container nav-wrap">
<a class="brand" asp-controller="Home" asp-action="Index">
<span class="brand-mark">W</span>
WebTimViec</a>

<button class="menu-toggle" type="button" aria-label="Mở menu" aria-expanded="false">
<span>
</span>

<span>
</span>

<span>
</span>

</button>

<nav class="main-nav">
<a asp-controller="Home" asp-action="Index">Trang chủ</a>

<a href="/Home/Index#categories">Ngành nghề</a>

<a href="/Home/Index#how-it-works">Hướng dẫn</a>

<a asp-controller="Home" asp-action="Privacy">Giới thiệu</a>

</nav>

<div class="nav-actions">
<a class="login-link" asp-controller="Account" asp-action="Login">Đăng nhập</a>

<a class="button button-small" asp-controller="Account" asp-action="Register">Tạo hồ sơ</a>

</div>

</div>

</header>

<main role="main">@RenderBody()</main>

<footer class="site-footer">
<div class="container footer-grid">
<div>
<a class="brand footer-brand" asp-controller="Home" asp-action="Index">
<span class="brand-mark">W</span>
WebTimViec</a>

<p>Nền tảng hỗ trợ người lao động xây dựng và giới thiệu hồ sơ tìm việc chuyên nghiệp.</p>

</div>

<div>
<h3>Khám phá</h3>

<a href="/Home/Index#categories">Nhóm ngành</a>

<a href="/Home/Index#how-it-works">Cách hoạt động</a>

</div>

<div>
<h3>Hỗ trợ</h3>

<a asp-controller="Home" asp-action="Privacy">Chính sách bảo mật</a>

<a href="mailto:hotro@webtimviec.local">Liên hệ hỗ trợ</a>

</div>

</div>

<div class="container footer-bottom">
<span>&copy; @DateTime.Now.Year WebTimViec</span>

<span>Đồ án chuyên ngành</span>

</div>

</footer>

<script src="~/js/site.js" asp-append-version="true">
</script>@await RenderSectionAsync("Scripts", required: false)
</body>

</html>

