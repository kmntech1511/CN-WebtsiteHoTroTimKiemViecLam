@model List<WebTimViec.Models.Entities.KinhNghiemLamViec>
@{
    ViewData["Title"] = "Kinh nghiệm làm việc";
}

<link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />

<section class="profile-page">
    <div class="container form-page-container">
        <div class="profile-heading">
            <div>
                <span class="eyebrow">HỒ SƠ TÌM VIỆC</span>
                <h1>Kinh nghiệm làm việc</h1>
                <p>@ViewBag.ResumeTitle</p>
            </div>
            <div class="form-actions-top">
                <a class="outline-button" asp-action="Index">← Hồ sơ của tôi</a>
                <a class="button" asp-action="AddExperience" asp-route-id="@ViewBag.ResumeId">+ Thêm kinh nghiệm</a>
            </div>
        </div>

        @if (Model.Count == 0)
        {
            <div class="empty-profile">
                <div class="empty-icon">◷</div>
                <h3>Chưa có kinh nghiệm làm việc</h3>
                <p>Thêm những công việc đã từng làm để hồ sơ thể hiện rõ hơn năng lực của bạn.</p>
                <a class="button" asp-action="AddExperience" asp-route-id="@ViewBag.ResumeId">Thêm kinh nghiệm đầu tiên</a>
            </div>
        }
        else
        {
            <div class="experience-list">
                @foreach (var item in Model)
                {
                    <article class="experience-card">
                        <div class="experience-icon">▣</div>
                        <div class="experience-content">
                            <h2>@item.ChucDanh</h2>
                            <strong>@item.TenCongTy</strong>
                            <p>@(item.DiaDiemLamViec ?? "Chưa cập nhật địa điểm") · @item.TuNgay.ToString("MM/yyyy") - @(item.DenNgay?.ToString("MM/yyyy") ?? "Hiện tại")</p>
                            @if (!string.IsNullOrWhiteSpace(item.MoTaCongViec))
                            {
                                <div class="experience-description">@item.MoTaCongViec</div>
                            }
                        </div>
                        <div class="experience-actions">
                            <a class="outline-button" asp-action="EditExperience" asp-route-id="@item.MaKinhNghiem">Sửa</a>
                            <form asp-action="DeleteExperience" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa kinh nghiệm này?');">
                                <input type="hidden" name="id" value="@item.MaKinhNghiem" />
                                <input type="hidden" name="resumeId" value="@item.MaHoSo" />
                                <button class="delete-button" type="submit">Xóa</button>
                            </form>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>
