@model List<WebTimViec.Models.HoSo.BangCapItemViewModel>
@{ ViewData["Title"] = "Bằng cấp"; }
<link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
<section class="profile-page">
<div class="container form-page-container">
<div class="profile-heading">
<div>
<span class="eyebrow">HỒ SƠ TÌM VIỆC</span>
<h1>Bằng cấp</h1>
<p>@ViewBag.ResumeTitle</p>
</div>
<div class="form-actions-top">
<a class="outline-button" asp-action="Index">← Hồ sơ của tôi</a>
<a class="button" asp-action="AddDegree" asp-route-id="@ViewBag.ResumeId">+ Thêm bằng cấp</a>
</div>
</div>@if(Model.Count==0){<div class="empty-profile">
<div class="empty-icon">▤</div>
<h3>Chưa có bằng cấp</h3>
<p>Thêm bằng cấp và quá trình đào tạo để hồ sơ đầy đủ hơn.</p>
<a class="button" asp-action="AddDegree" asp-route-id="@ViewBag.ResumeId">Thêm bằng cấp đầu tiên</a>
</div>}else{<div class="credential-list">@foreach(var item in Model){<article class="credential-card">
<div class="credential-icon">▤</div>
<div class="credential-content">
<h2>@item.TenBangCap</h2>
<strong>@(item.ChuyenNganh ?? "Chưa cập nhật chuyên ngành")</strong>
<p>@(item.TruongDaoTao ?? "Chưa cập nhật trường đào tạo") · @(item.NamTotNghiep?.ToString() ?? "Chưa cập nhật năm tốt nghiệp")</p>
</div>
<form asp-action="DeleteDegree" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa bằng cấp này?');">
<input type="hidden" name="id" value="@item.MaBangCap" />
<input type="hidden" name="resumeId" value="@ViewBag.ResumeId" />
<button class="delete-button" type="submit">Xóa</button>
</form>
</article>}</div>}</div>
</section>
