@{ ViewData["Title"] = "Đăng ký"; }
<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
<section class="auth-page">
<div class="auth-panel">
<div class="auth-intro">
<span class="eyebrow">BẮT ĐẦU HÀNH TRÌNH MỚI</span>

<h1>Tạo hồ sơ, mở rộng cơ hội.</h1>

<p>Tham gia WebTimViec để lưu trữ và giới thiệu năng lực của bạn một cách chuyên nghiệp.</p>

<div class="benefit-list">
<span>✓ Quản lý hồ sơ tập trung</span>

<span>✓ Sắp xếp kỹ năng, bằng cấp rõ ràng</span>

<span>✓ Chủ động cập nhật thông tin tìm việc</span>

</div>

</div>

<div class="auth-form-wrap">
<div class="form-heading">
<span class="brand-mark">W</span>

<h2>Tạo tài khoản</h2>

<p>Điền thông tin để bắt đầu</p>

</div>

<form>
<label for="fullname">Họ và tên</label>
<input id="fullname" type="text" placeholder="Nhập họ và tên" />
<label for="register-email">Email</label>
<input id="register-email" type="email" placeholder="you@example.com" />
<label for="register-password">Mật khẩu</label>
<input id="register-password" type="password" placeholder="Tối thiểu 6 ký tự" />
<label class="check terms">
<input type="checkbox" /> Tôi đồng ý với điều khoản sử dụng</label>
<button class="button form-button" type="submit">Tạo tài khoản</button>

<p class="form-switch">Đã có tài khoản? <a asp-action="Login">Đăng nhập</a>

</p>

</form>

</div>

</div>

</section>

