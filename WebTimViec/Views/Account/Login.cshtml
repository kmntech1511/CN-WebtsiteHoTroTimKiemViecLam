@model WebTimViec.Models.Account.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<section class="auth-page">
    <div class="auth-panel">
        <div class="auth-intro">
            <span class="eyebrow">CHÀO MỪNG BẠN TRỞ LẠI</span>
            <h1>Tiếp tục hành trình tìm việc của bạn.</h1>
            <p>Đăng nhập để quản lý hồ sơ và cập nhật thông tin năng lực của bạn.</p>
            <div class="auth-quote">“Một hồ sơ rõ ràng là bước đầu tiên để mở ra cơ hội phù hợp.”</div>
        </div>

        <div class="auth-form-wrap">
            <div class="form-heading">
                <span class="brand-mark">W</span>
                <h2>Đăng nhập</h2>
                <p>Nhập thông tin tài khoản của bạn</p>
            </div>

            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <div class="success-message">@successMessage</div>
            }

            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <label asp-for="Identifier"></label>
                <input asp-for="Identifier" placeholder="Nhập email hoặc tên đăng nhập" />
                <span asp-validation-for="Identifier" class="field-error"></span>

                <label asp-for="MatKhau"></label>
                <input asp-for="MatKhau" placeholder="Nhập mật khẩu" />
                <span asp-validation-for="MatKhau" class="field-error"></span>

                <div class="form-options">
                    <label class="check"><input asp-for="GhiNhoDangNhap" /> Ghi nhớ đăng nhập</label>
                    <a href="#">Quên mật khẩu?</a>
                </div>

                <button class="button form-button" type="submit">Đăng nhập</button>
                <p class="form-switch">Chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a></p>
            </form>
        </div>
    </div>
</section>
