@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Tổng quan";
}

<div class="admin-page-heading">
    <div>
        <span class="eyebrow">KHU VỰC QUẢN TRỊ</span>
        <h1>Tổng quan</h1>
        <p>Quản lý dữ liệu và hoạt động của hệ thống WebTimViec.</p>
    </div>
</div>

<div class="admin-stat-grid">
    <div class="admin-stat-card">
        <span class="admin-stat-icon blue">♙</span>
        <div>
            <strong>0</strong>
            <small>Người tìm việc</small>
        </div>
    </div>

    <div class="admin-stat-card">
        <span class="admin-stat-icon green">▣</span>
        <div>
            <strong>0</strong>
            <small>Hồ sơ tìm việc</small>
        </div>
    </div>

    <div class="admin-stat-card">
        <span class="admin-stat-icon orange">⌂</span>
        <div>
            <strong>0</strong>
            <small>Nhóm ngành</small>
        </div>
    </div>

    <div class="admin-stat-card">
        <span class="admin-stat-icon purple">✦</span>
        <div>
            <strong>0</strong>
            <small>Ngành nghề</small>
        </div>
    </div>
</div>

<section class="admin-panel">
    <div class="admin-panel-heading">
        <div>
            <h2>Thao tác nhanh</h2>
            <p>Quản lý các danh mục được sử dụng trong hồ sơ.</p>
        </div>
    </div>

    <div class="admin-quick-grid">
        <a href="#">
            <strong>Nhóm ngành</strong>
            <span>Phân loại nhóm ngành tuyển dụng</span>
        </a>

        <a href="#">
            <strong>Ngành nghề</strong>
            <span>Quản lý các ngành nghề</span>
        </a>

        <a href="#">
            <strong>Kỹ năng</strong>
            <span>Cập nhật danh mục kỹ năng</span>
        </a>
    </div>
</section>
